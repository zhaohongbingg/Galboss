# ---------------------------------------------------------------- 构建产物与缓存
build/
.gradle/
out/
*.class
*.log

# ---------------------------------------------------------------- IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/

# ---------------------------------------------------------------- Minecraft 运行目录
# gradlew runClient 生成的：存档 / 日志 / 崩溃报告 / 截图 / 配置。
# 结构体的产物已经落在 src/main/resources/data/galboss/structures/ 里，
# 这里不需要任何东西。
run/

# ---------------------------------------------------------------- Blockbench / MCP 中间产物
# 这些都是可重建的：session.json 每次重启失效，_state*.txt 是回写流程的临时输出，
# _preview/ 由 pipeline.mjs shot 与 verify_anims.mjs 生成。
# 注意不要忽略 blockbench/textures/*_armed.png 与 blockbench/ref/ —— 它们是流水线的输入。
blockbench/session.json
blockbench/_state*.txt
blockbench/_preview/
blockbench/_backup_*/
blockbench/_archive_*/

# ---------------------------------------------------------------- 系统文件
Thumbs.db
desktop.ini
