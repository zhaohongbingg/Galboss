  "pet.galboss.chat.locked": "（需好感度 %s）",

  "pet.galboss.chat.reizein_tohka.topic.0": "近况",
  "pet.galboss.chat.reizein_tohka.line.0": "你也是来汇报工作的吗？……不是的话，坐一会儿也行。",
  "pet.galboss.chat.reizein_tohka.topic.1": "学生会",
  "pet.galboss.chat.reizein_tohka.line.1": "最近违规的人少了很多。看来你也有在帮忙。",
  "pet.galboss.chat.reizein_tohka.topic.2": "心事",
  "pet.galboss.chat.reizein_tohka.line.2": "我不是天生就爱管人。只是没人管的话，大家都会受伤。",
  "pet.galboss.chat.reizein_tohka.topic.3": "约定",
  "pet.galboss.chat.reizein_tohka.line.3": "以后……也留在我身边吧。学生会需要一个可靠的人。",

  "pet.galboss.chat.tadasugawa_rei.topic.0": "招呼",
  "pet.galboss.chat.tadasugawa_rei.line.0": "……有事吗。没事的话，别挡路。",
  "pet.galboss.chat.tadasugawa_rei.topic.1": "站姿",
  "pet.galboss.chat.tadasugawa_rei.line.1": "你的站姿比上次像样了。继续保持。",
  "pet.galboss.chat.tadasugawa_rei.topic.2": "风纪",
  "pet.galboss.chat.tadasugawa_rei.line.2": "规则不是用来束缚人的，是让所有人都不受伤的。",
  "pet.galboss.chat.tadasugawa_rei.topic.3": "例外",
  "pet.galboss.chat.tadasugawa_rei.line.3": "你是少数几个……我不会开枪的人。",

  "pet.galboss.chat.onabuta_ikuko.topic.0": "邀战",
  "pet.galboss.chat.onabuta_ikuko.line.0": "哦？想打一场吗？我随时奉陪。",
  "pet.galboss.chat.onabuta_ikuko.topic.1": "架势",
  "pet.galboss.chat.onabuta_ikuko.line.1": "你的架势不错嘛！再来一次，这次我用全力！",
  "pet.galboss.chat.onabuta_ikuko.topic.2": "真心",
  "pet.galboss.chat.onabuta_ikuko.line.2": "战斗的时候，我才是最真实的自己。你不怕这样的我，对吧？",
  "pet.galboss.chat.onabuta_ikuko.topic.3": "通宵",
  "pet.galboss.chat.onabuta_ikuko.line.3": "下次……陪我一直打到天亮吧！说好了！",

